{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Heimdall": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "CandidateHeaderTimeout": "00:00:10",
