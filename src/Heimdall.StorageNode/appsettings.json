{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Heimdall": "Information"
    }
  },
  "AllowedHosts": "*",
  "Node": {
    "Id": "node-1",
    "ChunkSizeBytes": 8388608,
    "ReplicationEnabled": true,
    "ReplicationMaxAttempts": 4,
    "ReplicationBaseDelay": "00:00:02",
    "ReplicationMaxDelay": "00:00:30",
    "ReplicationAttemptTimeout": "00:10:00"
  },
  "Storage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "heimdall",
    "SecretKey": "heimdall-secret",
    "Bucket": "heimdall-node-1",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "CreateBucketIfMissing": true
  },
  "Cluster": {
    "ApiKey": "dev-heimdall-key",
    "VirtualNodesPerNode": 512,
    "ReplicationFactor": 3,
    "ReadReplicaPercentage": 60,
    "Nodes": [
      { "Id": "node-1", "BaseUrl": "http://localhost:8101", "Weight": 1 },
      { "Id": "node-2", "BaseUrl": "http://localhost:8102", "Weight": 1 },
      { "Id": "node-3", "BaseUrl": "http://localhost:8103", "Weight": 1 },
      { "Id": "node-4", "BaseUrl": "http://localhost:8104", "Weight": 1 },
      { "Id": "node-5", "BaseUrl": "http://localhost:8105", "Weight": 1 },
      { "Id": "node-6", "BaseUrl": "http://localhost:8106", "Weight": 1 }
    ]
  }
}
